# Copy to .env and replace every placeholder with unique values.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
MYSQL_PASSWORD=replace-with-a-long-random-app-password
SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes
CORS_ORIGINS=http://localhost
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-16-characters
INITIAL_ADMIN_NAME=ParkBay Administrator
