# ParkBay Environment Configuration
FLASK_ENV=development
SECRET_KEY=parkbay_ultra_secure_jwt_token_secret_key_2026

# MySQL Database Configuration
# If MySQL is running locally, set your credentials below:
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DB=smart_parking_db

# Alternatively, set full connection string:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/smart_parking_db

# Note: If MySQL is not detected or credentials fail, ParkBay will automatically
# fallback to local SQLite (parkbay.db) so the platform works smoothly without errors.
