# Local development configuration. Never commit your real .env file.
FLASK_ENV=development
SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_TOKEN_TTL_SECONDS=43200
RATELIMIT_STORAGE_URI=memory://

# Local MySQL settings. SQLite fallback is development-only.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=parkbay_user
MYSQL_PASSWORD=replace-with-your-local-password
MYSQL_DB=smart_parking_db

# Optional first administrator for a fresh database (minimum 16-character password).
# INITIAL_ADMIN_EMAIL=admin@example.com
# INITIAL_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-16-characters
# INITIAL_ADMIN_NAME=ParkBay Administrator
